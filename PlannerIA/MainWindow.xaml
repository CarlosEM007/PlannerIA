<Window x:Class="PlannerIA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PlannerIA.Controles"
        xmlns:vm="clr-namespace:PlannerIA.ViewModels"
        Title="PlannerIA" Width="1320" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fundo}"
        FontFamily="{StaticResource FonteTexto}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavegarCommand}" CommandParameter="Hoje" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavegarCommand}" CommandParameter="Semana" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavegarCommand}" CommandParameter="Mes" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavegarCommand}" CommandParameter="Geral" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavegarCommand}" CommandParameter="Config" />
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NovaTarefaAtalhoCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding NovaSemanaCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding AlternarTemaCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="G" Command="{Binding GerarComIaCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Raiz">
        <!-- ============ Conteúdo principal (desfocado quando há diálogo) ============ -->
        <Grid x:Name="Principal">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <Border Background="{DynamicResource Lateral}" BorderBrush="{DynamicResource Borda}" BorderThickness="0,0,1,0">
                <Grid Margin="16,0,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,8,0,0">
                        <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource Gradiente}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#7C5CFF" />
                            </Border.Effect>
                            <TextBlock Text="&#xE73A;" Style="{StaticResource Icone}" Foreground="White" FontSize="16" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PlannerIA" Style="{StaticResource Subtitulo}" FontSize="17" />
                            <TextBlock Text="sua rotina, offline" Style="{StaticResource Suave}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Navegação com indicador deslizante -->
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="Indicador" Width="220" Height="42" CornerRadius="10" Background="{DynamicResource AcentoSuave}" Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndicadorPos" />
                                </Border.RenderTransform>
                                <Border Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="0" Background="{DynamicResource Gradiente}" />
                            </Border>
                        </Canvas>
                        <StackPanel x:Name="Nav">
                            <TextBlock Text="PLANEJAR" Style="{StaticResource Rotulo}" Margin="14,0,0,8" />
                            <RadioButton Style="{StaticResource ItemNav}" Tag="&#xE706;" Content="Hoje" GroupName="Nav"
                                         IsChecked="{Binding PaginaSelecionada, Converter={StaticResource IgualA}, ConverterParameter=Hoje}" Checked="AoSelecionarNav" />
                            <RadioButton Style="{StaticResource ItemNav}" Tag="&#xE8C0;" Content="Semana" GroupName="Nav"
                                         IsChecked="{Binding PaginaSelecionada, Converter={StaticResource IgualA}, ConverterParameter=Semana}" Checked="AoSelecionarNav" />
                            <RadioButton Style="{StaticResource ItemNav}" Tag="&#xE787;" Content="Mês" GroupName="Nav"
                                         IsChecked="{Binding PaginaSelecionada, Converter={StaticResource IgualA}, ConverterParameter=Mes}" Checked="AoSelecionarNav" />
                            <RadioButton Style="{StaticResource ItemNav}" Tag="&#xE9D2;" Content="Visão geral" GroupName="Nav"
                                         IsChecked="{Binding PaginaSelecionada, Converter={StaticResource IgualA}, ConverterParameter=Geral}" Checked="AoSelecionarNav" />
                            <TextBlock Text="APP" Style="{StaticResource Rotulo}" Margin="14,20,0,8" />
                            <RadioButton Style="{StaticResource ItemNav}" Tag="&#xE713;" Content="Configurações" GroupName="Nav"
                                         IsChecked="{Binding PaginaSelecionada, Converter={StaticResource IgualA}, ConverterParameter=Config}" Checked="AoSelecionarNav" />
                        </StackPanel>
                    </Grid>

                    <!-- Resumo da semana -->
                    <StackPanel Grid.Row="3">
                        <!-- Status da IA (opcional) -->
                        <Button Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,10" Padding="10,8"
                                Command="{Binding GerarComIaCommand}" ToolTip="{Binding IaStatusDica}">
                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="PontoIa" Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextoFraco}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IaDisponivel}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Sucesso}" />
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Icone}" FontSize="12" Margin="0,0,6,0"
                                               Visibility="{Binding IaDisponivel, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Text="{Binding IaStatusTexto}" FontWeight="Normal" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Border Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="14" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46">
                                    <ctl:AnelProgresso Valor="{Binding ResumoFracao}" Espessura="5" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" />
                                    <TextBlock Text="{Binding ResumoPercentual}" Style="{StaticResource TextoBase}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ResumoTitulo}" Style="{StaticResource TextoBase}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding ResumoTexto}" Style="{StaticResource Suave}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Left" Margin="2,10,0,0" Command="{Binding AlternarTemaCommand}" ToolTip="Alternar tema (Ctrl+T)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" Style="{StaticResource Icone}" FontSize="13" />
                                <TextBlock Text="Alternar tema" Margin="10,0,0,0" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Área de conteúdo -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource BotaoJanela}" Content="&#xE921;" Click="Minimizar" ToolTip="Minimizar" />
                    <Button x:Name="BotaoMaximizar" Style="{StaticResource BotaoJanela}" Content="&#xE922;" Click="Maximizar" ToolTip="Maximizar" />
                    <Button Style="{StaticResource BotaoFechar}" Content="&#xE8BB;" Click="Fechar" ToolTip="Fechar" />
                </StackPanel>
                <ctl:TransicaoContentControl Grid.Row="1" Content="{Binding PaginaAtual}" Focusable="False" />
            </Grid>
        </Grid>

        <!-- ============ Toasts ============ -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border x:Name="Toast" Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="12"
                            Padding="16,12" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Right" Effect="{StaticResource SombraForte}"
                            ctl:Animacoes.EntradaEmCascata="True">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Icone" Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Sucesso}">
                                <TextBlock Text="{Binding Icone}" Style="{StaticResource Icone}" Foreground="White" FontSize="12" />
                            </Border>
                            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource TextoBase}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" MaxWidth="340" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Erro}" Value="True">
                            <Setter TargetName="Icone" Property="Background" Value="{DynamicResource Perigo}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============ Diálogo ============ -->
        <Grid x:Name="CamadaDialogo" Visibility="Collapsed" Opacity="0">
            <Border Background="{DynamicResource Backdrop}" MouseLeftButtonDown="AoClicarFundoDialogo" />
            <Border x:Name="CartaoDialogo" Style="{StaticResource Cartao}" Width="{Binding Content.Largura, ElementName=ConteudoDialogo, FallbackValue=540}"
                    Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    Background="{DynamicResource Superficie}" Effect="{StaticResource SombraForte}" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="EscalaDialogo" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <StackPanel>
                    <ContentPresenter x:Name="ConteudoDialogo" />
                    <TextBlock Text="{Binding Content.Erro, ElementName=ConteudoDialogo}" Style="{StaticResource TextoBase}" Foreground="{DynamicResource Perigo}" FontSize="13"
                               Margin="0,14,0,0" TextWrapping="Wrap" Visibility="{Binding Content.Erro, ElementName=ConteudoDialogo, Converter={StaticResource BoolVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource BotaoSecundario}" Content="{Binding Content.TextoCancelar, ElementName=ConteudoDialogo}" Command="{Binding Content.CancelarCommand, ElementName=ConteudoDialogo}" />
                        <Button x:Name="BotaoConfirmar" Margin="10,0,0,0" Content="{Binding Content.TextoConfirmar, ElementName=ConteudoDialogo}"
                                Command="{Binding Content.ConfirmarCommand, ElementName=ConteudoDialogo}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Content.Perigo, ElementName=ConteudoDialogo}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Perigo}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
