<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CorFundo">#0E1014</Color>
    <Color x:Key="CorLateral">#12151B</Color>
    <Color x:Key="CorSuperficie">#171A21</Color>
    <Color x:Key="CorSuperficie2">#1F232C</Color>
    <Color x:Key="CorSuperficieHover">#252A35</Color>
    <Color x:Key="CorBorda">#2A2F3A</Color>
    <Color x:Key="CorTexto">#ECEEF3</Color>
    <Color x:Key="CorTextoSuave">#9AA3B2</Color>
    <Color x:Key="CorTextoFraco">#5F6878</Color>
    <Color x:Key="CorAcento">#7C5CFF</Color>
    <Color x:Key="CorAcento2">#B16CFF</Color>
    <Color x:Key="CorAcentoSuave">#2A2350</Color>
    <Color x:Key="CorSucesso">#22C3A6</Color>
    <Color x:Key="CorAviso">#F5A524</Color>
    <Color x:Key="CorPerigo">#F0506E</Color>
    <Color x:Key="CorSombra">#000000</Color>

    <SolidColorBrush x:Key="Fundo" Color="{StaticResource CorFundo}" />
    <SolidColorBrush x:Key="Lateral" Color="{StaticResource CorLateral}" />
    <SolidColorBrush x:Key="Superficie" Color="{StaticResource CorSuperficie}" />
    <SolidColorBrush x:Key="Superficie2" Color="{StaticResource CorSuperficie2}" />
    <SolidColorBrush x:Key="SuperficieHover" Color="{StaticResource CorSuperficieHover}" />
    <SolidColorBrush x:Key="Borda" Color="{StaticResource CorBorda}" />
    <SolidColorBrush x:Key="Texto" Color="{StaticResource CorTexto}" />
    <SolidColorBrush x:Key="TextoSuave" Color="{StaticResource CorTextoSuave}" />
    <SolidColorBrush x:Key="TextoFraco" Color="{StaticResource CorTextoFraco}" />
    <SolidColorBrush x:Key="Acento" Color="{StaticResource CorAcento}" />
    <SolidColorBrush x:Key="AcentoSuave" Color="{StaticResource CorAcentoSuave}" />
    <SolidColorBrush x:Key="Sucesso" Color="{StaticResource CorSucesso}" />
    <SolidColorBrush x:Key="Aviso" Color="{StaticResource CorAviso}" />
    <SolidColorBrush x:Key="Perigo" Color="{StaticResource CorPerigo}" />
    <SolidColorBrush x:Key="Trilho" Color="#262B36" />
    <SolidColorBrush x:Key="Backdrop" Color="#99000000" />
    <SolidColorBrush x:Key="TextoSobreAcento" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="Gradiente" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource CorAcento}" />
        <GradientStop Offset="1" Color="{StaticResource CorAcento2}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GradienteHero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2B2160" />
        <GradientStop Offset="0.55" Color="#1C1A35" />
        <GradientStop Offset="1" Color="#171A21" />
    </LinearGradientBrush>
</ResourceDictionary>
