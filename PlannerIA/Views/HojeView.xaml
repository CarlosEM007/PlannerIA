<UserControl x:Class="PlannerIA.Views.HojeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PlannerIA.Controles">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,8,40,40" MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Sobretitulo}" Style="{StaticResource Rotulo}" Foreground="{DynamicResource Acento}" />
                    <TextBlock Text="{Binding Saudacao}" Style="{StaticResource Titulo}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TituloData}" Style="{StaticResource Suave}" FontSize="15" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76B;" Command="{Binding DiaAnteriorCommand}" ToolTip="Dia anterior" />
                    <Button Style="{StaticResource BotaoSecundario}" Content="Hoje" Margin="6,0" Padding="14,8" Command="{Binding IrHojeCommand}" />
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76C;" Command="{Binding ProximoDiaCommand}" ToolTip="Próximo dia" />
                    <Button Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" ToolTip="Gerar plano com IA (Ctrl+G)"
                            Command="{Binding DataContext.GerarComIaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding DataContext.IaDisponivel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icone}" FontSize="13" Foreground="{DynamicResource Acento}" />
                            <TextBlock Text="Gerar com IA" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Command="{Binding NovaTarefaCommand}"
                            Visibility="{Binding SemPlano, Converter={StaticResource BoolVisInv}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" FontSize="12" />
                            <TextBlock Text="Nova tarefa" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1" ContentTemplate="{StaticResource EstadoVazio}" Content="{Binding}"
                            Visibility="{Binding SemPlano, Converter={StaticResource BoolVis}}" />

            <!-- Hero: progresso do dia + semana -->
            <Grid Grid.Row="1" Margin="0,28,0,0" Visibility="{Binding SemPlano, Converter={StaticResource BoolVisInv}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Cartao}" Background="{DynamicResource GradienteHero}" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="96" Height="96">
                            <ctl:AnelProgresso Valor="{Binding ProgressoFracao}" Espessura="9" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" />
                            <TextBlock Text="{Binding ProgressoPercentual}" Style="{StaticResource Subtitulo}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PROGRESSO DO DIA" Style="{StaticResource Rotulo}" />
                            <TextBlock Text="{Binding ProgressoTexto}" Style="{StaticResource Subtitulo}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ResumoDia}" Style="{StaticResource Suave}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Cartao}" Padding="24">
                    <Grid>
                        <StackPanel Visibility="{Binding TemSemana, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <TextBlock Text="OBJETIVO DA SEMANA" Style="{StaticResource Rotulo}" />
                                <Button Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Right" Margin="0,-8,-8,0" Padding="8,4" Command="{Binding AbrirSemanaCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Abrir semana" FontSize="12" />
                                        <TextBlock Text="&#xE76C;" Style="{StaticResource Icone}" FontSize="9" Margin="6,1,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding Semana.Objetivo}" Style="{StaticResource Subtitulo}" FontSize="17" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:BarraProgresso Valor="{Binding SemanaFracao}" Height="6" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SemanaTexto}" Style="{StaticResource Suave}" FontSize="12" Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding Semana.Titulo}" Style="{StaticResource Suave}" FontSize="12" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding TemSemana, Converter={StaticResource BoolVisInv}}">
                            <TextBlock Text="FORA DO PLANO" Style="{StaticResource Rotulo}" />
                            <TextBlock Text="Nenhuma semana cadastrada contém este dia." Style="{StaticResource Subtitulo}" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Listas -->
            <Grid Grid.Row="2" Margin="0,28,0,0" Visibility="{Binding SemPlano, Converter={StaticResource BoolVisInv}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Para este dia" Style="{StaticResource Subtitulo}" Margin="4,0,0,12" />
                    <Border Style="{StaticResource Cartao}" Padding="8">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Tarefas}" ItemTemplate="{StaticResource LinhaTarefa}" />
                            <StackPanel Margin="20,28" HorizontalAlignment="Center" Visibility="{Binding TemTarefas, Converter={StaticResource BoolVisInv}}">
                                <TextBlock Text="&#xE706;" Style="{StaticResource Icone}" FontSize="28" Foreground="{DynamicResource Aviso}" />
                                <TextBlock Text="Nada agendado para este dia" Style="{StaticResource TextoBase}" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center" />
                                <TextBlock Text="Use “Nova tarefa” ou pegue algo da semana sem data." Style="{StaticResource Suave}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <StackPanel Visibility="{Binding TemAtrasadas, Converter={StaticResource BoolVis}}" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" Foreground="{DynamicResource Perigo}" FontSize="14" />
                            <TextBlock Text="Atrasadas" Style="{StaticResource Subtitulo}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource Cartao}" Padding="8" BorderBrush="{DynamicResource Perigo}">
                            <ItemsControl ItemsSource="{Binding Atrasadas}" ItemTemplate="{StaticResource LinhaTarefa}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding TemSemData, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Da semana, sem dia fixo" Style="{StaticResource Subtitulo}" Margin="4,0,0,12" />
                        <Border Style="{StaticResource Cartao}" Padding="8">
                            <ItemsControl ItemsSource="{Binding SemData}" ItemTemplate="{StaticResource LinhaTarefa}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
