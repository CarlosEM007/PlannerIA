<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PlannerIA.ViewModels"
                    xmlns:views="clr-namespace:PlannerIA.Views"
                    xmlns:ctl="clr-namespace:PlannerIA.Controles">

    <!-- ================= Páginas ================= -->
    <DataTemplate DataType="{x:Type vm:HojeViewModel}">
        <views:HojeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SemanaViewModel}">
        <views:SemanaView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MesViewModel}">
        <views:MesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:VisaoGeralViewModel}">
        <views:VisaoGeralView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ConfiguracoesViewModel}">
        <views:ConfiguracoesView />
    </DataTemplate>

    <!-- ================= Diálogos ================= -->
    <DataTemplate DataType="{x:Type vm:DialogoTarefaViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Contexto}" Style="{StaticResource Rotulo}" Margin="0,0,0,4"
                       Visibility="{Binding Contexto, Converter={StaticResource BoolVis}}" />
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" FontSize="22" Margin="0,0,0,20" />

            <TextBlock Text="Nome" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
            <TextBox x:Name="CampoNome" Style="{StaticResource Campo}" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Ex.: Corrigir os bugs que faltam" ctl:Foco.AoCarregar="True" />

            <TextBlock Text="Dia" Style="{StaticResource Rotulo}" Margin="0,18,0,8" />
            <ListBox Style="{StaticResource ListaChips}" ItemsSource="{Binding Dias}" SelectedItem="{Binding DiaSelecionado}"
                     DisplayMemberPath="Rotulo" />

            <TextBlock Text="Notas (opcional)" Style="{StaticResource Rotulo}" Margin="0,10,0,6" />
            <TextBox Style="{StaticResource Campo}" Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Links, detalhes, lembretes…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DialogoSemanaViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" FontSize="22" Margin="0,0,0,20" />

            <TextBlock Text="Título (opcional)" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
            <TextBox Style="{StaticResource Campo}" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Gerado automaticamente: Semana N — 16 a 22/11" ctl:Foco.AoCarregar="True" />

            <TextBlock Text="Objetivo da semana" Style="{StaticResource Rotulo}" Margin="0,18,0,6" />
            <TextBox Style="{StaticResource Campo}" Text="{Binding Objetivo, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Ex.: Terminar o jogo atual e começar a game jam" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Início" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76B;" Command="{Binding InicioMenosCommand}" ToolTip="Dia anterior" />
                        <TextBox Grid.Column="1" Margin="6,0" Style="{StaticResource Campo}" HorizontalContentAlignment="Center"
                                 Text="{Binding InicioTexto, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Style="{StaticResource BotaoIconeBorda}" Content="&#xE76C;" Command="{Binding InicioMaisCommand}" ToolTip="Próximo dia" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fim" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76B;" Command="{Binding FimMenosCommand}" ToolTip="Dia anterior" />
                        <TextBox Grid.Column="1" Margin="6,0" Style="{StaticResource Campo}" HorizontalContentAlignment="Center"
                                 Text="{Binding FimTexto, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Style="{StaticResource BotaoIconeBorda}" Content="&#xE76C;" Command="{Binding FimMaisCommand}" ToolTip="Próximo dia" />
                    </Grid>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Resumo}" Style="{StaticResource Suave}" Margin="0,10,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DialogoConfirmacaoViewModel}">
        <StackPanel>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Perigo}" HorizontalAlignment="Left" Margin="0,0,0,16" Opacity="0.9">
                <TextBlock Text="&#xE74D;" Style="{StaticResource Icone}" Foreground="White" FontSize="18" />
            </Border>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" FontSize="22" Margin="0,0,0,10" />
            <TextBlock Text="{Binding Mensagem}" Style="{StaticResource Suave}" FontSize="14" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
    </DataTemplate>

    <!-- ================= Linha de tarefa (visão Dia) ================= -->
    <DataTemplate x:Key="LinhaTarefa" DataType="{x:Type vm:TarefaItemViewModel}">
        <Grid x:Name="Linha" Background="Transparent" Margin="0,0,0,6" ctl:Animacoes.EntradaEmCascata="True">
            <Border x:Name="HoverFundo" Background="{DynamicResource SuperficieHover}" CornerRadius="12" Opacity="0" />
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Concluida, Mode=TwoWay}" IsEnabled="{Binding PodeMarcar}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <StackPanel Grid.Column="1" Margin="14,0,8,0">
                    <TextBlock x:Name="TituloTxt" Text="{Binding Titulo}" Style="{StaticResource TextoBase}" FontSize="15" TextWrapping="Wrap" TextTrimming="None" />
                    <WrapPanel Margin="0,6,0,0">
                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding Cor}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TituloPrincipal}" Style="{StaticResource Suave}" FontSize="12" Margin="6,0,0,0" MaxWidth="260" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0" Visibility="{Binding TemData, Converter={StaticResource BoolVis}}">
                            <TextBlock x:Name="DataTxt" Text="{Binding DataTexto}" Style="{StaticResource Suave}" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding Notas}" Style="{StaticResource Suave}" FontSize="12" VerticalAlignment="Center" MaxWidth="420"
                                   Visibility="{Binding TemNotas, Converter={StaticResource BoolVis}}" />
                    </WrapPanel>
                </StackPanel>
                <Border x:Name="Acoes" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                        Background="{DynamicResource Superficie2}" CornerRadius="9" Padding="2" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BotaoIcone}" Content="&#xE70F;" Command="{Binding EditarCommand}" ToolTip="Editar" />
                        <Button Style="{StaticResource BotaoIcone}" Content="&#xE74D;" Command="{Binding RemoverCommand}" ToolTip="Excluir" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Concluida}" Value="True">
                <Setter TargetName="TituloTxt" Property="TextDecorations" Value="Strikethrough" />
                <Setter TargetName="TituloTxt" Property="Foreground" Value="{DynamicResource TextoFraco}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Atrasada}" Value="True">
                <Setter TargetName="DataTxt" Property="Foreground" Value="{DynamicResource Perigo}" />
            </DataTrigger>
            <Trigger SourceName="Linha" Property="IsMouseOver" Value="True">
                <Setter TargetName="Acoes" Property="IsHitTestVisible" Value="True" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverFundo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Acoes" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverFundo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="Acoes" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Subtarefa dentro do cartão (visão Semana) ================= -->
    <DataTemplate x:Key="LinhaSubtarefa" DataType="{x:Type vm:TarefaItemViewModel}">
        <Grid x:Name="Linha" Background="Transparent">
            <Border x:Name="HoverFundo" Background="{DynamicResource SuperficieHover}" CornerRadius="10" Opacity="0" Margin="-8,0" />
            <Grid Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Concluida, Mode=TwoWay}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="12,1,8,0">
                    <TextBlock x:Name="TituloTxt" Text="{Binding Titulo}" Style="{StaticResource TextoBase}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding Notas}" Style="{StaticResource Suave}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding TemNotas, Converter={StaticResource BoolVis}}" />
                </StackPanel>
                <Border x:Name="ChipData" Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Top" Visibility="{Binding TemData, Converter={StaticResource BoolVis}}">
                    <TextBlock x:Name="DataTxt" Text="{Binding DataTexto}" Style="{StaticResource Suave}" FontSize="12" />
                </Border>
                <!-- ações sobrepostas (não ocupam espaço do título) -->
                <Border x:Name="Acoes" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-4,0"
                        Background="{DynamicResource Superficie2}" CornerRadius="8" Padding="2" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BotaoIcone}" Width="28" Height="28" FontSize="12" Content="&#xE74A;" Command="{Binding MoverAcimaCommand}" ToolTip="Mover para cima" />
                        <Button Style="{StaticResource BotaoIcone}" Width="28" Height="28" FontSize="12" Content="&#xE74B;" Command="{Binding MoverAbaixoCommand}" ToolTip="Mover para baixo" />
                        <Button Style="{StaticResource BotaoIcone}" Width="28" Height="28" FontSize="12" Content="&#xE70F;" Command="{Binding EditarCommand}" ToolTip="Editar" />
                        <Button Style="{StaticResource BotaoIcone}" Width="28" Height="28" FontSize="12" Content="&#xE74D;" Command="{Binding RemoverCommand}" ToolTip="Excluir" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Concluida}" Value="True">
                <Setter TargetName="TituloTxt" Property="TextDecorations" Value="Strikethrough" />
                <Setter TargetName="TituloTxt" Property="Foreground" Value="{DynamicResource TextoFraco}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EhHoje}" Value="True">
                <Setter TargetName="ChipData" Property="Background" Value="{DynamicResource AcentoSuave}" />
                <Setter TargetName="DataTxt" Property="Foreground" Value="{DynamicResource Acento}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Atrasada}" Value="True">
                <Setter TargetName="DataTxt" Property="Foreground" Value="{DynamicResource Perigo}" />
            </DataTrigger>
            <Trigger SourceName="Linha" Property="IsMouseOver" Value="True">
                <Setter TargetName="Acoes" Property="IsHitTestVisible" Value="True" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverFundo" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Acoes" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverFundo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetName="Acoes" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Cartão de tarefa principal (visão Semana) ================= -->
    <DataTemplate x:Key="CartaoTarefa" DataType="{x:Type vm:TarefaItemViewModel}">
        <Border x:Name="Card" Style="{StaticResource Cartao}" Padding="0" ctl:Animacoes.EntradaEmCascata="True">
            <Grid>
                <!-- faixa de cor da categoria -->
                <Border Height="3" VerticalAlignment="Top" CornerRadius="16,16,0,0" Background="{Binding Cor}" Opacity="0.9" />
                <StackPanel Margin="20,18,20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- principal sem subtarefas: marca à mão -->
                        <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Concluida, Mode=TwoWay}" Margin="0,0,12,0"
                                  Visibility="{Binding PodeMarcar, Converter={StaticResource BoolVis}}" />
                        <!-- principal com subtarefas: selo automático -->
                        <Grid Width="22" Height="22" Margin="0,0,12,0" Visibility="{Binding TemSubtarefas, Converter={StaticResource BoolVis}}">
                            <ctl:AnelProgresso Valor="{Binding ProgressoFracao}" Espessura="3" Trilho="{DynamicResource Trilho}" Preenchimento="{Binding Cor}" />
                            <Border x:Name="SeloOk" CornerRadius="11" Background="{DynamicResource Sucesso}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SeloEscala" ScaleX="0.5" ScaleY="0.5" />
                                </Border.RenderTransform>
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icone}" FontSize="11" Foreground="White" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TituloTxt" Grid.Column="1" Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" FontSize="16"
                                   TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="{Binding TemSubtarefas, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding ProgressoTexto}" Style="{StaticResource Suave}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <ctl:BarraProgresso Margin="0,14,0,6" Height="5" Valor="{Binding ProgressoFracao}" Trilho="{DynamicResource Trilho}" Preenchimento="{Binding Cor}"
                                        Visibility="{Binding TemSubtarefas, Converter={StaticResource BoolVis}}" />

                    <TextBlock Text="{Binding Notas}" Style="{StaticResource Suave}" Margin="34,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding TemNotas, Converter={StaticResource BoolVis}}" />

                    <ItemsControl ItemsSource="{Binding Subtarefas}" ItemTemplate="{StaticResource LinhaSubtarefa}" Margin="0,6,0,0" />

                    <Grid Margin="-6,6,-8,0">
                        <Button Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Left" Command="{Binding AdicionarSubtarefaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" FontSize="11" />
                                <TextBlock Text="Subtarefa" Margin="8,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="Acoes" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False">
                            <Button Style="{StaticResource BotaoIcone}" Content="&#xE74A;" Command="{Binding MoverAcimaCommand}" ToolTip="Mover para cima" />
                            <Button Style="{StaticResource BotaoIcone}" Content="&#xE74B;" Command="{Binding MoverAbaixoCommand}" ToolTip="Mover para baixo" />
                            <Button Style="{StaticResource BotaoIcone}" Content="&#xE70F;" Command="{Binding EditarCommand}" ToolTip="Editar tarefa" />
                            <Button Style="{StaticResource BotaoIcone}" Content="&#xE74D;" Command="{Binding RemoverCommand}" ToolTip="Excluir tarefa" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Concluida}" Value="True">
                <Setter TargetName="TituloTxt" Property="Foreground" Value="{DynamicResource TextoSuave}" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SeloOk" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="SeloEscala" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Mola}" />
                            <DoubleAnimation Storyboard.TargetName="SeloEscala" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Mola}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SeloOk" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="SeloEscala" Storyboard.TargetProperty="ScaleX" To="0.5" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="SeloEscala" Storyboard.TargetProperty="ScaleY" To="0.5" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TextoFraco}" />
                <Setter TargetName="Acoes" Property="IsHitTestVisible" Value="True" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Acoes" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Acoes" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ================= Estado vazio ================= -->
    <DataTemplate x:Key="EstadoVazio">
        <Border Style="{StaticResource Cartao}" Padding="40" HorizontalAlignment="Center" MaxWidth="560" Margin="0,40,0,0">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource Gradiente}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8C0;" Style="{StaticResource Icone}" FontSize="26" Foreground="White" />
                </Border>
                <TextBlock Text="Vamos montar o seu plano" Style="{StaticResource Subtitulo}" FontSize="22" HorizontalAlignment="Center" Margin="0,20,0,8" />
                <TextBlock Style="{StaticResource Suave}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                           Text="Importe a sua planilha de objetivos semanais (uma aba por semana) ou crie a primeira semana do zero. Tudo fica salvo só no seu computador." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Style="{StaticResource BotaoPrimario}" Command="{Binding DataContext.ImportarPlanilhaCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" Style="{StaticResource Icone}" FontSize="13" />
                            <TextBlock Text="Importar planilha" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BotaoSecundario}" Margin="10,0,0,0" Command="{Binding DataContext.NovaSemanaCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" FontSize="12" />
                            <TextBlock Text="Criar semana" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ================= Diálogo: gerar plano com IA ================= -->
    <DataTemplate x:Key="PropostaSubtarefa" DataType="{x:Type vm:TarefaPropostaViewModel}">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Incluir}" VerticalAlignment="Center" ToolTip="Incluir no plano" />
            <TextBox Grid.Column="1" Style="{StaticResource CampoEmLinha}" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="6,0"
                     IsEnabled="{Binding Incluir}" />
            <Border Grid.Column="2" Style="{StaticResource Chip}" Visibility="{Binding TemData, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding DataTexto}" Style="{StaticResource Suave}" FontSize="12" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PropostaTarefa" DataType="{x:Type vm:TarefaPropostaViewModel}">
        <StackPanel Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Incluir}" VerticalAlignment="Center" ToolTip="Incluir no plano" />
                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{Binding Cor}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Style="{StaticResource CampoEmLinha}" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="4,0"
                         IsEnabled="{Binding Incluir}" />
                <Border Grid.Column="3" Style="{StaticResource Chip}" Visibility="{Binding TemData, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding DataTexto}" Style="{StaticResource Suave}" FontSize="12" />
                </Border>
            </Grid>
            <TextBlock Text="{Binding Notas}" Style="{StaticResource Suave}" FontSize="12" Margin="52,2,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Visibility="{Binding TemNotas, Converter={StaticResource BoolVis}}" />
            <ItemsControl ItemsSource="{Binding Subtarefas}" ItemTemplate="{StaticResource PropostaSubtarefa}" Margin="32,4,0,0"
                          IsEnabled="{Binding Incluir}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DialogoIaViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="&#xE945;" Style="{StaticResource Icone}" FontSize="12" Foreground="{DynamicResource Acento}" />
                <TextBlock Text="ASSISTENTE DE IA" Style="{StaticResource Rotulo}" Foreground="{DynamicResource Acento}" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" FontSize="22" Margin="0,0,0,16" />

            <!-- Etapa 1: pedido -->
            <StackPanel Visibility="{Binding EmPedido, Converter={StaticResource BoolVis}}">
                <TextBlock Text="O que você quer planejar?" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Campo}" Text="{Binding Pedido, UpdateSourceTrigger=PropertyChanged}" ctl:Foco.AoCarregar="True"
                         Tag="Ex.: Até 19/12 quero terminar o jogo, fazer uma jam de 1 semana e ler .NET 3x por semana"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="Ctrl+Enter para gerar · a IA vê as semanas já cadastradas para não duplicar" Style="{StaticResource Suave}" FontSize="12" Margin="2,6,0,0" />
                <TextBlock Text="EXEMPLOS" Style="{StaticResource Rotulo}" Margin="0,16,0,8" />
                <ItemsControl ItemsSource="{Binding Exemplos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="10,6" Margin="-10,0,0,0"
                                    Command="{Binding DataContext.UsarExemploCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Icone}" FontSize="9" Margin="0,2,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding}" FontWeight="Normal" TextWrapping="Wrap" MaxWidth="600" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Etapa 2: gerando -->
            <StackPanel Visibility="{Binding EmGeracao, Converter={StaticResource BoolVis}}" Margin="0,24,0,24" HorizontalAlignment="Center">
                <Grid Width="64" Height="64" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="Giro" />
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Giro" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <ctl:AnelProgresso Valor="0.3" Espessura="6" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" />
                </Grid>
                <TextBlock Text="Montando o seu plano…" Style="{StaticResource Subtitulo}" FontSize="16" HorizontalAlignment="Center" Margin="0,18,0,4" />
                <TextBlock Text="Pode levar alguns segundos. Nada é salvo antes da sua confirmação." Style="{StaticResource Suave}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Etapa 3: prévia -->
            <StackPanel Visibility="{Binding EmPrevia, Converter={StaticResource BoolVis}}">
                <Border Background="{DynamicResource AcentoSuave}" CornerRadius="10" Padding="14,10" Visibility="{Binding Resumo, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource TextoBase}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" />
                </Border>
                <ItemsControl ItemsSource="{Binding Avisos}" Margin="0,8,0,0" Visibility="{Binding TemAvisos, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icone}" FontSize="11" Foreground="{DynamicResource Aviso}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock Text="{Binding}" Style="{StaticResource Suave}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" MaxWidth="600" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,12,-12,0" Padding="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding Semanas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SemanaPropostaViewModel}">
                                <Border x:Name="Caixa" Background="{DynamicResource Superficie2}" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                                        ctl:Animacoes.EntradaEmCascata="True">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding Incluir}" VerticalAlignment="Center" ToolTip="Incluir esta semana" />
                                            <TextBox Grid.Column="1" Style="{StaticResource CampoEmLinha}" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold"
                                                     Margin="6,0" IsEnabled="{Binding Incluir}" />
                                            <Border x:Name="Selo" Grid.Column="2" Style="{StaticResource Chip}" Background="{DynamicResource AcentoSuave}">
                                                <TextBlock x:Name="SeloTxt" Text="{Binding Destino}" Style="{StaticResource Rotulo}" FontSize="10" Foreground="{DynamicResource Acento}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Margin="40,2,0,0" IsEnabled="{Binding Incluir}">
                                            <TextBlock Text="{Binding Intervalo}" Style="{StaticResource Suave}" FontSize="12" Margin="6,0,0,4" />
                                            <TextBox Style="{StaticResource CampoEmLinha}" Text="{Binding Objetivo, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                                                     Foreground="{DynamicResource TextoSuave}" ToolTip="Objetivo da semana (opcional)" />
                                            <ItemsControl ItemsSource="{Binding Tarefas}" ItemTemplate="{StaticResource PropostaTarefa}" Margin="-34,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding EhExistente}" Value="True">
                                        <Setter TargetName="Selo" Property="Background" Value="{DynamicResource Superficie}" />
                                        <Setter TargetName="SeloTxt" Property="Foreground" Value="{DynamicResource Sucesso}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Incluir}" Value="False">
                                        <Setter TargetName="Caixa" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Style="{StaticResource BotaoFantasma}" HorizontalAlignment="Left" Margin="-10,4,0,0" Command="{Binding RefazerPedidoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" FontSize="12" />
                        <TextBlock Text="Ajustar o pedido e gerar de novo" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
