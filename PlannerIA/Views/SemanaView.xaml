<UserControl x:Class="PlannerIA.Views.SemanaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PlannerIA.Controles">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,8,40,40" MaxWidth="1400">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Selo}" Style="{StaticResource Rotulo}" Foreground="{DynamicResource Acento}" />
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource Titulo}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding Intervalo}" Style="{StaticResource Suave}" FontSize="15" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76B;" Command="{Binding AnteriorCommand}" ToolTip="Semana anterior" />
                    <Button Style="{StaticResource BotaoSecundario}" Content="Atual" Margin="6,0" Padding="14,8" Command="{Binding AtualCommand}" />
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76C;" Command="{Binding ProximaCommand}" ToolTip="Próxima semana" />
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE70F;" Margin="12,0,0,0" Command="{Binding EditarCommand}" ToolTip="Editar semana"
                            Visibility="{Binding TemSemana, Converter={StaticResource BoolVis}}" />
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE74D;" Margin="6,0,0,0" Command="{Binding RemoverCommand}" ToolTip="Excluir semana"
                            Visibility="{Binding TemSemana, Converter={StaticResource BoolVis}}" />
                    <Button Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0"
                            Command="{Binding DataContext.NovaSemanaCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" Style="{StaticResource Icone}" FontSize="13" />
                            <TextBlock Text="Nova semana" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" ToolTip="Gerar plano com IA (Ctrl+G)"
                            Command="{Binding DataContext.GerarComIaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding DataContext.IaDisponivel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icone}" FontSize="13" Foreground="{DynamicResource Acento}" />
                            <TextBlock Text="Gerar com IA" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BotaoPrimario}" Margin="8,0,0,0" Command="{Binding NovaTarefaCommand}"
                            Visibility="{Binding TemSemana, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icone}" FontSize="12" />
                            <TextBlock Text="Nova tarefa" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1" ContentTemplate="{StaticResource EstadoVazio}" Content="{Binding}"
                            Visibility="{Binding TemSemana, Converter={StaticResource BoolVisInv}}" />

            <!-- Objetivo + progresso -->
            <Border Grid.Row="1" Style="{StaticResource Cartao}" Background="{DynamicResource GradienteHero}" Padding="28,24" Margin="0,28,0,0"
                    Visibility="{Binding TemSemana, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="OBJETIVO" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding Objetivo}" Style="{StaticResource Subtitulo}" FontSize="20" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Visibility="{Binding TemObjetivo, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="Sem objetivo definido. Clique em editar para escrever um." Style="{StaticResource Suave}" Margin="0,8,0,0"
                                   Visibility="{Binding TemObjetivo, Converter={StaticResource BoolVisInv}}" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctl:BarraProgresso Valor="{Binding ProgressoFracao}" Height="8" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressoTexto}" Style="{StaticResource Suave}" Margin="14,0,0,0" />
                        </Grid>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="104" Height="104">
                        <ctl:AnelProgresso Valor="{Binding ProgressoFracao}" Espessura="10" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" />
                        <TextBlock Text="{Binding ProgressoPercentual}" Style="{StaticResource Subtitulo}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Faixa de dias -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Dias}" Margin="0,16,0,0" Visibility="{Binding TemSemana, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Dia" Command="{Binding AbrirCommand}" Margin="4,0" Cursor="Hand" ToolTip="Ver o dia">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Fundo" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="14" />
                                        <Border x:Name="Hover" Background="{DynamicResource SuperficieHover}" CornerRadius="14" Opacity="0" />
                                        <ContentPresenter />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Margin="10,12">
                                <TextBlock x:Name="Sem" Text="{Binding Semana}" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Num" Text="{Binding Numero}" Style="{StaticResource Subtitulo}" FontSize="22" HorizontalAlignment="Center" Margin="0,2,0,6" />
                                <ctl:BarraProgresso Valor="{Binding Fracao}" Height="4" Margin="6,0" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Sucesso}" />
                                <TextBlock Text="{Binding Texto}" Style="{StaticResource Suave}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                <Setter TargetName="Sem" Property="Foreground" Value="{DynamicResource Acento}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Acento}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TemTarefas}" Value="False">
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextoFraco}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cartões das tarefas -->
            <ItemsControl Grid.Row="3" Margin="0,28,0,0" ItemsSource="{Binding Tarefas}" ItemTemplate="{StaticResource CartaoTarefa}"
                          Visibility="{Binding TemSemana, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctl:ColunasPanel LarguraMinimaColuna="360" Espacamento="16" MaximoColunas="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
