<UserControl x:Class="PlannerIA.Views.VisaoGeralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PlannerIA.Controles">
    <UserControl.Resources>
        <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Cartao}">
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,8,40,40" MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="VISÃO GERAL" Style="{StaticResource Rotulo}" Foreground="{DynamicResource Acento}" />
                <TextBlock Text="Todo o plano" Style="{StaticResource Titulo}" Margin="0,4,0,0" />
                <TextBlock Text="Mês → semanas → tarefas, com o progresso de cada nível." Style="{StaticResource Suave}" FontSize="15" Margin="0,4,0,0" />
            </StackPanel>

            <ContentControl Grid.Row="1" ContentTemplate="{StaticResource EstadoVazio}" Content="{Binding}"
                            Visibility="{Binding SemPlano, Converter={StaticResource BoolVis}}" />

            <!-- Indicadores -->
            <Grid Grid.Row="1" Margin="0,28,0,0" Visibility="{Binding SemPlano, Converter={StaticResource BoolVisInv}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Kpi}" Background="{DynamicResource GradienteHero}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="64" Height="64">
                            <ctl:AnelProgresso Valor="{Binding GeralFracao}" Espessura="7" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" />
                            <TextBlock Text="{Binding GeralPercentual}" Style="{StaticResource TextoBase}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PROGRESSO GERAL" Style="{StaticResource Rotulo}" />
                            <TextBlock Text="{Binding SubtarefasTexto}" Style="{StaticResource Subtitulo}" FontSize="20" Margin="0,4,0,0" />
                            <TextBlock Text="subtarefas" Style="{StaticResource Suave}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Kpi}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SEMANAS 100%" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding SemanasTexto}" Style="{StaticResource Titulo}" FontSize="26" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Kpi}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ATRASADAS" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding AtrasadasTexto}" Style="{StaticResource Titulo}" FontSize="26" Margin="0,6,0,0" Foreground="{DynamicResource Perigo}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Kpi}" Margin="0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DIAS ATÉ O FIM" Style="{StaticResource Rotulo}" />
                        <TextBlock Text="{Binding DiasRestantesTexto}" Style="{StaticResource Titulo}" FontSize="26" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Árvore -->
            <ItemsControl Grid.Row="2" Margin="0,28,0,0" ItemsSource="{Binding Meses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Cartao}" Margin="0,0,0,16" Padding="24,20" ctl:Animacoes.EntradaEmCascata="True">
                            <Expander Style="{StaticResource Expansor}" IsExpanded="{Binding Expandido, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}" FontSize="20" />
                                            <TextBlock Text="{Binding Texto}" Style="{StaticResource Suave}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ctl:BarraProgresso Grid.Column="1" Height="8" Valor="{Binding Fracao}" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Percentual}" Style="{StaticResource Subtitulo}" FontSize="16" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding Semanas}" Margin="28,16,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Linha" Background="{DynamicResource Superficie2}" CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                                <Expander Style="{StaticResource Expansor}" IsExpanded="{Binding Expandido, Mode=TwoWay}">
                                                    <Expander.Header>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="160" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,16,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource TextoBase}" FontWeight="SemiBold" />
                                                                    <Border Style="{StaticResource Chip}" Background="{DynamicResource AcentoSuave}" Margin="10,0,0,0" Padding="6,1"
                                                                            Visibility="{Binding EhAtual, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="AGORA" Style="{StaticResource Rotulo}" FontSize="10" Foreground="{DynamicResource Acento}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Objetivo}" Style="{StaticResource Suave}" FontSize="12" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <ctl:BarraProgresso Grid.Column="1" Height="6" Valor="{Binding Fracao}" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Texto}" Style="{StaticResource Suave}" FontSize="12" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                                                            <Button Grid.Column="3" Style="{StaticResource BotaoIcone}" Content="&#xE8A7;" Margin="8,0,0,0" Command="{Binding AbrirCommand}" ToolTip="Abrir semana" />
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Tarefas}" Margin="28,10,8,4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="8" Height="8" Fill="{Binding Cor}" VerticalAlignment="Center" />
                                                                    <TextBlock x:Name="T" Grid.Column="1" Text="{Binding Titulo}" Style="{StaticResource TextoBase}" FontSize="13" Margin="12,0,12,0" />
                                                                    <ctl:BarraProgresso Grid.Column="2" Height="4" Valor="{Binding Fracao}" Trilho="{DynamicResource Trilho}" Preenchimento="{Binding Cor}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Texto}" Style="{StaticResource Suave}" FontSize="12" Width="56" TextAlignment="Right" />
                                                                </Grid>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Concluida}" Value="True">
                                                                        <Setter TargetName="T" Property="Foreground" Value="{DynamicResource TextoFraco}" />
                                                                        <Setter TargetName="T" Property="TextDecorations" Value="Strikethrough" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
