<UserControl x:Class="PlannerIA.Views.MesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PlannerIA.Controles">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,8,40,40" MaxWidth="1400">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MÊS" Style="{StaticResource Rotulo}" Foreground="{DynamicResource Acento}" />
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource Titulo}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ctl:BarraProgresso Width="180" Height="6" Valor="{Binding ProgressoFracao}" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ProgressoTexto}" Style="{StaticResource Suave}" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76B;" Command="{Binding MesAnteriorCommand}" ToolTip="Mês anterior" />
                    <Button Style="{StaticResource BotaoSecundario}" Content="Este mês" Margin="6,0" Padding="14,8" Command="{Binding MesAtualCommand}" />
                    <Button Style="{StaticResource BotaoIconeBorda}" Content="&#xE76C;" Command="{Binding ProximoMesCommand}" ToolTip="Próximo mês" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="460" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- Calendário -->
                <Border Style="{StaticResource Cartao}" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding NomesDias}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Rotulo}" HorizontalAlignment="Center" Margin="0,4,0,10" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Dias}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Celula" Command="{Binding AbrirCommand}" Margin="3" Height="86" Cursor="Hand" ToolTip="{Binding Dica}"
                                            ctl:Animacoes.EntradaEmCascata="True">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border x:Name="Fundo" Background="{DynamicResource Superficie2}" CornerRadius="12" Opacity="0.0" />
                                                    <Border x:Name="Hover" Background="{DynamicResource SuperficieHover}" CornerRadius="12" Opacity="0" />
                                                    <Border x:Name="Aro" BorderBrush="{DynamicResource Acento}" BorderThickness="2" CornerRadius="12" Opacity="0" />
                                                    <ContentPresenter />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding NoPlano}" Value="True">
                                                        <Setter TargetName="Fundo" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                        <Setter TargetName="Aro" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid Margin="10,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock x:Name="Num" Text="{Binding Numero}" Style="{StaticResource TextoBase}" FontWeight="SemiBold" />
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icone}" FontSize="11" Foreground="{DynamicResource Sucesso}" HorizontalAlignment="Right"
                                                           Visibility="{Binding Completo, Converter={StaticResource BoolVis}}" />
                                            </Grid>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Marcadores}" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Ellipse x:Name="Ponto" Width="7" Height="7" Margin="0,0,4,0" Fill="{Binding Cor}" />
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Feita}" Value="False">
                                                                <Setter TargetName="Ponto" Property="Opacity" Value="0.45" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Row="2" Text="{Binding Texto}" Style="{StaticResource Suave}" FontSize="11" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NoMes}" Value="False">
                                            <Setter TargetName="Celula" Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                            <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Acento}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Semanas do mês -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Semanas" Style="{StaticResource Subtitulo}" Margin="4,0,0,12" />
                    <TextBlock Text="Nenhuma semana começa neste mês." Style="{StaticResource Suave}" Margin="4,0,0,0"
                               Visibility="{Binding TemSemanas, Converter={StaticResource BoolVisInv}}" />
                    <ItemsControl ItemsSource="{Binding Semanas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding AbrirCommand}" Margin="0,0,0,12" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                        ctl:Animacoes.EntradaEmCascata="True">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="Fundo" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1" CornerRadius="14" />
                                                <Border x:Name="Hover" Background="{DynamicResource SuperficieHover}" CornerRadius="14" Opacity="0" />
                                                <ContentPresenter />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Hover" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding EhAtual}" Value="True">
                                                    <Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource Acento}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Margin="18,16">
                                        <Grid>
                                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TextoBase}" FontWeight="SemiBold" Margin="0,0,24,0" />
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icone}" FontSize="12" Foreground="{DynamicResource Sucesso}" HorizontalAlignment="Right"
                                                       Visibility="{Binding Completa, Converter={StaticResource BoolVis}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Objetivo}" Style="{StaticResource Suave}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" MaxHeight="40" />
                                        <ctl:BarraProgresso Margin="0,12,0,0" Height="5" Valor="{Binding Fracao}" Trilho="{DynamicResource Trilho}" Preenchimento="{DynamicResource Gradiente}" />
                                        <TextBlock Text="{Binding Texto}" Style="{StaticResource Suave}" FontSize="11" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
