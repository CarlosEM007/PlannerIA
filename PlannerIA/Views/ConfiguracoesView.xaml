<UserControl x:Class="PlannerIA.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,8,40,40" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource Rotulo}" Foreground="{DynamicResource Acento}" />
            <TextBlock Text="Preferências" Style="{StaticResource Titulo}" Margin="0,4,0,28" />

            <!-- Aparência -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Aparência" Style="{StaticResource Subtitulo}" FontSize="16" />
                        <TextBlock Text="Tema da interface. A escolha fica salva." Style="{StaticResource Suave}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Superficie2}" CornerRadius="10" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segmento}" GroupName="Tema"
                                         IsChecked="{Binding Tema, Converter={StaticResource IgualA}, ConverterParameter=Escuro}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE708;" Style="{StaticResource Icone}" FontSize="12" />
                                    <TextBlock Text="Escuro" Margin="8,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Segmento}" GroupName="Tema"
                                         IsChecked="{Binding Tema, Converter={StaticResource IgualA}, ConverterParameter=Claro}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" Style="{StaticResource Icone}" FontSize="12" />
                                    <TextBlock Text="Claro" Margin="8,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Planilha -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Importar planilha (.xlsx)" Style="{StaticResource Subtitulo}" FontSize="16" />
                        <TextBlock Style="{StaticResource Suave}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Uma aba por semana com título “Semana 1 — 16 a 22/11”, linha “Objetivo:” e as colunas Tipo, Tarefa, Dia, Feito e Notas. Semanas que já existem (mesmas datas) são ignoradas." />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Center"
                            Command="{Binding DataContext.ImportarPlanilhaCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" Style="{StaticResource Icone}" FontSize="13" />
                            <TextBlock Text="Importar" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- IA (opcional) -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
              <StackPanel>
                <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icone}" FontSize="14" Foreground="{DynamicResource Acento}" />
                            <TextBlock Text="Assistente de IA" Style="{StaticResource Subtitulo}" FontSize="16" Margin="8,0,0,0" />
                            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="8,2">
                                <TextBlock Text="OPCIONAL" Style="{StaticResource Rotulo}" FontSize="10" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Suave}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Gera planos a partir de um pedido em texto, com prévia antes de salvar. Liga sozinho quando há um provedor (Claude CLI ou chave da API) e internet; sem isso, o app funciona normalmente." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Aviso}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IaDisponivel}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Sucesso}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding IaStatusTexto}" Style="{StaticResource TextoBase}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding IaStatusDica}" Style="{StaticResource Suave}" FontSize="12" Margin="16,2,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center" Command="{Binding VerificarIaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}" FontSize="13" />
                            <TextBlock Text="Verificar de novo" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Provedor: Claude CLI (assinatura) ou API (chave) -->
                <Border Height="1" Background="{DynamicResource Borda}" Margin="0,20,0,18" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="COMO USAR A IA" Style="{StaticResource Rotulo}" />
                        <TextBlock Style="{StaticResource Suave}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Automático usa o Claude CLI (sua assinatura Pro/Max, sem custo extra) se estiver instalado; senão, a API com chave (cobrança à parte)." />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Superficie2}" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segmento}" GroupName="ModoIa" Content="Automático"
                                         IsChecked="{Binding ModoIa, Converter={StaticResource IgualA}, ConverterParameter=Automatico}" />
                            <RadioButton Style="{StaticResource Segmento}" GroupName="ModoIa" Content="Claude CLI"
                                         IsChecked="{Binding ModoIa, Converter={StaticResource IgualA}, ConverterParameter=ClaudeCli}" />
                            <RadioButton Style="{StaticResource Segmento}" GroupName="ModoIa" Content="API (chave)"
                                         IsChecked="{Binding ModoIa, Converter={StaticResource IgualA}, ConverterParameter=Api}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Claude CLI -->
                <StackPanel Margin="0,20,0,0" Visibility="{Binding MostrarCli, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="CLAUDE CLI (ASSINATURA)" Style="{StaticResource Rotulo}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextoFraco}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CliInstalado}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Sucesso}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding CliTexto}" Style="{StaticResource TextoBase}" FontSize="13" Margin="8,0,0,0" TextWrapping="Wrap" TextTrimming="None" MaxWidth="640" />
                    </StackPanel>

                    <!-- Não instalado: como instalar -->
                    <StackPanel Visibility="{Binding CliInstalado, Converter={StaticResource BoolVisInv}}" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Suave}" FontSize="12" TextWrapping="Wrap" TextTrimming="None"
                                   Text="1. Instale o Claude Code rodando este comando no PowerShell. 2. Clique em “Fazer login” e entre com a sua conta do Claude. 3. Clique em “Verificar de novo”." />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Superficie2}" CornerRadius="8" Padding="12,9">
                                <TextBlock Text="irm https://claude.ai/install.ps1 | iex" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{DynamicResource Texto}" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding CopiarComandoInstalacaoCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icone}" FontSize="13" />
                                    <TextBlock Text="Copiar" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource BotaoSecundario}" Command="{Binding AbrirLoginCliCommand}" IsEnabled="{Binding CliInstalado}"
                                ToolTip="Abre um terminal com o Claude para você entrar com a sua conta">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE756;" Style="{StaticResource Icone}" FontSize="13" />
                                <TextBlock Text="Fazer login no Claude CLI" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Suave}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource TextoFraco}"
                               Text="Cada geração conta no limite de uso da sua assinatura. O app roda “claude -p” sem ferramentas (não lê nem altera arquivos) e sem guardar a conversa." />
                </StackPanel>

                <!-- Chave da API: salva como variável de ambiente do usuário (via PowerShell) -->
                <StackPanel Margin="0,20,0,0" Visibility="{Binding MostrarChave, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="CHAVE DA API (COBRANÇA À PARTE)" Style="{StaticResource Rotulo}" />
                    <TextBlock Text="{Binding ChaveAtualTexto}" Style="{StaticResource TextoBase}" FontSize="13" Margin="0,6,0,0"
                               FontFamily="Cascadia Mono, Consolas, Segoe UI" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="CampoChave" Style="{StaticResource CampoSenha}" PasswordChanged="AoMudarChave"
                                     ToolTip="Cole aqui a chave criada no Claude Console (sk-ant-...)" />
                        <TextBlock Text="Cole a nova chave (sk-ant-…)" Style="{StaticResource Suave}" Foreground="{DynamicResource TextoFraco}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding NovaChave, Converter={StaticResource BoolVisInv}}" />
                        <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}" Margin="10,0,0,0" Command="{Binding SalvarChaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icone}" FontSize="13" />
                                <TextBlock Text="Salvar chave" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Command="{Binding RemoverChaveCommand}"
                                Visibility="{Binding TemChaveDoUsuario, Converter={StaticResource BoolVis}}" ToolTip="Apagar a variável do Windows">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icone}" FontSize="13" />
                                <TextBlock Text="Remover" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding AvisoChave}" Style="{StaticResource Suave}" FontSize="12" Foreground="{DynamicResource Aviso}" Margin="2,8,0,0"
                               TextWrapping="Wrap" TextTrimming="None" Visibility="{Binding AvisoChave, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="Salvando…" Style="{StaticResource Suave}" FontSize="12" Margin="2,8,0,0"
                               Visibility="{Binding SalvandoChave, Converter={StaticResource BoolVis}}" />
                    <TextBlock Style="{StaticResource Suave}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap" TextTrimming="None" Foreground="{DynamicResource TextoFraco}">
                        <Run Text="O app roda um comando do PowerShell que grava a chave na variável" />
                        <Run Text="{Binding NomeVariavelChave, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="do seu usuário no Windows. Ela não fica em nenhum arquivo do app, e outros programas que você abrir depois também passam a enxergá-la." />
                    </TextBlock>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Dados -->
            <Border Style="{StaticResource Cartao}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dados locais" Style="{StaticResource Subtitulo}" FontSize="16" />
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource AcentoSuave}" Margin="10,0,0,0" Padding="8,2">
                                <TextBlock Text="OFFLINE" Style="{StaticResource Rotulo}" FontSize="10" Foreground="{DynamicResource Acento}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tudo fica em um banco SQLite no seu computador. Nada vai para servidor; só quando você usa a IA o pedido e um resumo das semanas são enviados à API do Claude." Style="{StaticResource Suave}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding ArquivoBanco}" Style="{StaticResource Suave}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,10,0,0" Foreground="{DynamicResource TextoFraco}" />
                        <TextBlock Text="{Binding Estatisticas}" Style="{StaticResource Suave}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource BotaoSecundario}" VerticalAlignment="Center" Command="{Binding AbrirPastaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icone}" FontSize="13" />
                            <TextBlock Text="Abrir pasta" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource Suave}" FontSize="12" Margin="4,8,0,0" Foreground="{DynamicResource TextoFraco}"
                       Text="Atalhos: Ctrl+1…5 trocam de tela · Ctrl+N nova tarefa · Ctrl+Shift+N nova semana · Ctrl+G gerar com IA · Ctrl+T alterna o tema" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
