<Application x:Class="PlannerIA.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Índice 0: tema (trocado em tempo de execução pelo GerenciadorTema) -->
                <ResourceDictionary Source="Temas/Escuro.xaml" />
                <ResourceDictionary Source="Temas/Estilos.xaml" />
                <ResourceDictionary Source="Views/Modelos.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
